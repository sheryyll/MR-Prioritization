# secrets.toml.example — copy to .streamlit/secrets.toml and fill in real values.
# The real secrets.toml is git-ignored; this example file IS committed.
#
# Currently MR-Rank does not require any secrets to run.
# Add entries here if you need, e.g., an analytics key or a password:
#
# [auth]
# password = "your-viewer-password"
#
# [analytics]
# ga_id = "G-XXXXXXXXXX"
